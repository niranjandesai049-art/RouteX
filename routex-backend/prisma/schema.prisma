generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  full_name     String
  email         String    @unique
  phone         String?
  profile_image String?
  is_verified   Boolean?  @default(false)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@map("users")
  @@schema("public")
}

model Booking {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_reference          String                    @unique @db.VarChar(20)
  shipper_id                 String?                   @db.Uuid
  company_id                 String?                   @db.Uuid
  driver_id                  String?                   @db.Uuid
  truck_id                   String?                   @db.Uuid
  cargo_description          String
  estimated_weight_kg        Decimal?                  @db.Decimal(10, 2)
  pickup_address             Json                      @default("{}")
  delivery_address           Json                      @default("{}")
  quoted_price               Decimal                   @default(0.00) @db.Decimal(12, 2)
  currency                   String?                   @default("INR") @db.VarChar(10)
  status                     booking_status            @default(draft)
  scheduled_pickup           DateTime?                 @db.Timestamptz(6)
  actual_pickup              DateTime?                 @db.Timestamptz(6)
  actual_delivery            DateTime?                 @db.Timestamptz(6)
  created_at                 DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at                 DateTime?                 @db.Timestamptz(6)
  ai_logs                    ai_logs[]
  companies                  companies?                @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  drivers                    drivers?                  @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  profiles                   profiles?                 @relation(fields: [shipper_id], references: [id], onUpdate: NoAction)
  trucks                     trucks?                   @relation(fields: [truck_id], references: [id], onUpdate: NoAction)
  live_gps_states            live_gps_states?
  payments                   Payment[]
  ratings                    ratings?
  tracking_logs              TrackingLog[]
  driver_wallet_transactions DriverWalletTransaction[]
  booking_stops              booking_stops[]

  @@index([driver_id], map: "idx_bookings_driver")
  @@index([shipper_id], map: "idx_bookings_shipper")
  @@index([status], map: "idx_bookings_status")
  @@map("bookings")
  @@schema("public")
}

model TrackingLog {
  id              BigInt                   @id @default(autoincrement())
  booking_id      String                   @db.Uuid
  driver_id       String?                  @db.Uuid
  gps_coordinates Unsupported("geometry")?
  latitude        Decimal                  @db.Decimal(10, 8)
  longitude       Decimal                  @db.Decimal(11, 8)
  speed_kmh       Decimal?                 @db.Decimal(5, 2)
  heading_degrees Decimal?                 @db.Decimal(5, 2)
  battery_level   Int?
  logged_at       DateTime                 @default(now()) @db.Timestamptz(6)
  bookings        Booking                  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drivers         drivers?                 @relation(fields: [driver_id], references: [id], onUpdate: NoAction)

  @@index([booking_id, logged_at(sort: Desc)], map: "idx_tracking_logs_booking")
  @@index([gps_coordinates], map: "idx_tracking_logs_geo", type: Gist)
  @@map("tracking_logs")
  @@schema("public")
}

model Payment {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id             String?        @db.Uuid
  wallet_id              String?        @db.Uuid
  amount                 Decimal        @db.Decimal(12, 2)
  currency               String         @default("INR") @db.VarChar(10)
  method                 payment_method @default(wallet)
  status                 payment_status @default(pending)
  gateway_transaction_id String?        @unique @db.VarChar(255)
  gateway_response       Json           @default("{}")
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime       @default(now()) @db.Timestamptz(6)
  bookings               Booking?       @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  wallets                wallets?       @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)

  @@map("payments")
  @@schema("public")
}

