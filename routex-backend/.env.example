# RouteX Backend Environment Variables Template
# Copy this to .env and configure your credentials

# PostgreSQL connection string (Supabase or local instance)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# HTTP service port (default: 3001)
PORT=3001

# JWT Secret for signing authentication tokens
JWT_SECRET=your_jwt_secret_here

# Groq API key for Llama 3.3 AI pricing models
GROQ_API_KEY=your_groq_api_key_here

# Authentication OTP Mode (development | production)
# In development mode, generated OTPs are logged to server console
AUTH_OTP_MODE=development

# SMS Provider Selection (console | fast2sms | twilio | msg91)
SMS_PROVIDER=console

# Provider 1: Fast2SMS Credentials (Recommended for India)
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_ROUTE=otp

# Provider 2: Twilio Credentials (Global SMS Gateway)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Provider 3: MSG91 Credentials (Enterprise Indian Gateway)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_template_id

# Email Provider Credentials (console | smtp | sendgrid)
EMAIL_PROVIDER=console
