# ==========================================
# RouteX Backend - API & Microservices Configuration
# ==========================================

PORT=3001
NODE_ENV=production

# PostgreSQL / Supabase Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/routex?schema=public"

# JWT Security Key
JWT_SECRET=routex-jwt-production-secret-token-change-in-prod

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK Credentials (Optional for cloud FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Map & Routing Geocoding Engine
GOOGLE_MAPS_API_KEY=
