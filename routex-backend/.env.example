# RouteX Backend Environment Variables Template
# Copy this to .env and configure the credentials

# PostgreSQL connection string (Supabase or local instance)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# HTTP service port (default: 3001)
PORT=3001

# HS256 JWT Secret used for signing authentication tokens (Generate a cryptographically secure key)
JWT_SECRET=your_jwt_secret_here

# Groq API key for Llama 3.3 pricing models
GROQ_API_KEY=your_groq_api_key_here

# Firebase Service Account JSON (alternative to firebase-service-account.json file)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Clerk Secret Key for Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
